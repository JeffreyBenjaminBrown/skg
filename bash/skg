#!/bin/bash
# USAGE: bash/skg [ARGUMENT ...]
#   Runs the skg binary this repository built, with the arguments given:
#   target/release/skg if it exists, else target/debug/skg. It finds
#   the repository from its own path (through any symlink to it), so it
#   runs from any directory, and reads relative paths among the
#   arguments against the directory it is run from.
#   'bash/skg --help' lists the subcommands. It builds nothing; a server
#   started by bash/start-servers.sh builds, as does
#   'cargo build --release --bin skg'.
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
for profile in release debug; do
  if [ -x "$ROOT/target/$profile/skg" ]; then
    exec "$ROOT/target/$profile/skg" "$@"
  fi
done
echo "bash/skg: neither $ROOT/target/release/skg nor $ROOT/target/debug/skg exists. Build one with: cd $(printf '%q' "$ROOT") && cargo build --release --bin skg" >&2
exit 1
