{
  "comment": "Herald styles, read at load time by the server's tests and both clients. A style states a herald's importance tier, or for a few heralds a polarity or kind, never its hue. See docs/heralds.org.",
  "styles_comment": "Each style is a foreground, an optional background and an optional underline (true). Foreground/background inversions of these styles are an unused reserve.",
  "styles": {
    "crucial":     { "foreground": "black",   "background": "#00ffff" },
    "high":        { "foreground": "black",   "background": "yellow" },
    "medium":      { "foreground": "white",   "background": "#d2691e" },
    "low":         { "foreground": "white",   "background": "#5e5e20" },
    "normal":      { "foreground": "white",   "background": "blue" },
    "message":     { "foreground": "black",   "background": "white" },
    "stop":        { "foreground": "white",   "background": "red" },
    "go":          { "foreground": "black",   "background": "#00bb00" },
    "nonstandard": { "foreground": "white",   "background": "#8b00ff" },
    "yucky":       { "foreground": "#c84286" }
  },
  "view_faces_comment": "Skg dictates every face in a view, in both clients: these colors and weights replace the user's theme for the Org elements a view contains (not the typeface). They follow Jeff's Emacs setup: rainbow headlines, from his custom faces, and the manoj-dark theme's Org faces. Each entry names the Emacs faces and Neovim highlight groups it governs. A face with no background gets the default's.",
  "view_faces": [
    {"name": "default", "emacs": ["default"], "nvim": ["Normal", "NormalNC", "EndOfBuffer"], "foreground": "white", "background": "black"},
    {"name": "headline_level_1", "emacs": ["org-level-1"], "nvim": ["@org.headline.level1"], "foreground": "#ff8888"},
    {"name": "headline_level_2", "emacs": ["org-level-2"], "nvim": ["@org.headline.level2"], "foreground": "#ffa500"},
    {"name": "headline_level_3", "emacs": ["org-level-3"], "nvim": ["@org.headline.level3"], "foreground": "#ffff00"},
    {"name": "headline_level_4", "emacs": ["org-level-4"], "nvim": ["@org.headline.level4"], "foreground": "#00ff00"},
    {"name": "headline_level_5", "emacs": ["org-level-5"], "nvim": ["@org.headline.level5"], "foreground": "#00ffff"},
    {"name": "headline_level_6", "emacs": ["org-level-6"], "nvim": ["@org.headline.level6"], "foreground": "#0000ff"},
    {"name": "headline_level_7", "emacs": ["org-level-7"], "nvim": ["@org.headline.level7"], "foreground": "#a020f0"},
    {"name": "headline_level_8", "emacs": ["org-level-8"], "nvim": ["@org.headline.level8"], "foreground": "#ff0000"},
    {"name": "link", "emacs": ["org-link"], "nvim": ["@org.hyperlink", "@org.hyperlink.desc", "@org.hyperlink.url"], "foreground": "#00ffff", "underline": true},
    {"name": "code", "emacs": ["org-code"], "nvim": ["@org.code"], "foreground": "#b3b3b3"},
    {"name": "verbatim", "emacs": ["org-verbatim"], "nvim": ["@org.verbatim"], "foreground": "#b3b3b3", "underline": true},
    {"name": "block", "emacs": ["org-block", "org-block-begin-line", "org-block-end-line", "org-meta-line"], "nvim": ["@org.block", "@org.directive"], "foreground": "#b3b3b3"},
    {"name": "drawer", "emacs": ["org-drawer"], "nvim": ["@org.drawer", "@org.properties"], "foreground": "#87cefa"},
