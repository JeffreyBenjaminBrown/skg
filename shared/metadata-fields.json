{
  "comment": "The metadata fields a user may set on each kind of headline, read by both clients' metadata editors (C-c v m) for the fill-in, the strip step and the cyclers, and checked against the server's parser by a conformance test (tests/metadata_fields_table.rs).",
  "kinds_comment": "A kind is known by its atom in '(skg ...)', bare or, for a kind with a parameter, as the head of a list ('(flag noSearchMatching)'). Its fields stand beside it at the top level of '(skg ...)' ('(skg node (gnid X) writeProtected)', '(skg alias (editRequest ...))'). A kind with no fields shows what the headline carries. The kinds that take a readiness request list none: the readiness commands set it.",
  "fields_comment": "Each field has a 'shape': 'atom', a bare atom, present or absent; 'one', a form holding one value; or 'some', a form holding any number of values. Its 'default' is what its absence means; the editors show it as 'DEFAULT (default)' and strip it. Its 'values' are what its cycle runs through after the default. A value with 'arguments' prompts for each when chosen and is written as a list, '(VALUE ARG...)'; an argument is 'of' an id (a link is accepted), 'of' a skgrepo, or 'one_of' a fixed list. A value with 'when' is offered only when the headline is 'editable' (not write-protected) or a 'removedMember' (its metadata carries '(diff (rel removed))'; where it stands the save checks).",
  "kinds": [
    { "kind": "occurrence", "atoms": [ "node" ],
      "fields": [
        { "name": "writeProtected", "shape": "atom", "default": "false",
          "values": [ { "value": "true" } ] },
        { "name": "noClaim", "shape": "atom", "default": "false",
          "values": [ { "value": "true" } ] },
        { "name": "editRequest", "shape": "one", "default": "none",
          "values": [
            { "value": "delete", "when": "editable" },
            { "value": "merge", "when": "editable",
              "arguments": [ { "of": "id" } ] },
            { "value": "relRepo",
              "arguments": [ { "of": "skgrepo" } ] },
            { "value": "flag", "when": "editable",
              "arguments": [ { "one_of": [ "noSearchMatching" ] },
                             { "one_of": [ "true", "false" ] } ] },
            { "value": "restoreRel", "when": "removedMember" } ] },
        { "name": "viewRequests", "shape": "some", "default": "none",
          "values": [
            { "value": "editableView" },
            { "value": "writeProtectedView" },
            { "value": "writeProtectedSubtreeView" },
            { "value": "fork" },
            { "value": "flags" },
            { "value": "folder",
              "arguments": [ { "one_of": [ "aliases", "overrides",
                                           "hidesFromSubs", "subscribesTo",
                                           "containers", "mentioners" ] } ] } ] } ] },
    { "kind": "ghost", "atoms": [ "ghost" ],
      "fields": [
        { "name": "noClaim", "shape": "atom", "default": "false",
          "values": [ { "value": "true" } ] },
        { "name": "editRequest", "shape": "one", "default": "none",
          "values": [ { "value": "restoreNode" } ] },
        { "name": "viewRequests", "shape": "some", "default": "none",
          "values": [ { "value": "tombstone" } ] } ] },
    { "kind": "unknown", "atoms": [ "unknown" ],
      "fields": [
        { "name": "noClaim", "shape": "atom", "default": "false",
          "values": [ { "value": "true" } ] },
        { "name": "editRequest", "shape": "one", "default": "none",
          "values": [ { "value": "relRepo",
                        "arguments": [ { "of": "skgrepo" } ] } ] } ] },
    { "kind": "alias", "atoms": [ "alias" ],
      "fields": [
        { "name": "noClaim", "shape": "atom", "default": "false",
          "values": [ { "value": "true" } ] },
        { "name": "editRequest", "shape": "one", "default": "none",
          "values": [ { "value": "relRepo",
                        "arguments": [ { "of": "skgrepo" } ] } ] } ] },
    { "kind": "ID", "atoms": [ "id" ],
      "fields": [
        { "name": "noClaim", "shape": "atom", "default": "false",
          "values": [ { "value": "true" } ] } ] },
    { "kind": "flag", "atoms": [ "flag" ],
      "fields": [] },
    { "kind": "the diff view's change viewnodes",
      "atoms": [ "oldText", "bodyDiff",
                 "homeSkgrepoMove", "relRepoMove", "changesetMarker" ],
      "fields": [] },
    { "kind": "folder",
      "atoms": [ "aliasFolder", "idFolder", "flagsFolder",
                 "subscribeeFolder", "subscriberFolder",
                 "overriddenFolder", "overriderFolder",
                 "hiderFolder", "hiddenFolder",
                 "hiddenInSubscribeeFolder",
                 "hiddenOutsideOfSubscribeeFolder",
                 "containerFolder", "mentionerFolder",
                 "acquiredByFolder", "acquiredFolder" ],
      "fields": [] },
    { "kind": "tombstone", "atoms": [ "tombstone" ],
      "fields": [] },
    { "kind": "buffer root", "atoms": [ "forestRoot" ],
      "fields": [] }
  ]
}
