{
  "comment": "The node-node relations, read by the server's tests and both clients. Rust keeps its own enum (NodeRelation) for exhaustive matching; a conformance test checks it against this file. 'roles' are [first, second]: the first role's node records each relationship ('recorded_by'). 'folders' maps a role to the partner folder that lists nodes playing that role, or null.",
  "relations": [
    { "name": "contains",
      "letter": "C", "display_position": 0,
      "roles": [ "container", "content" ],
      "recorded_by": "container",
      "folders": { "container": null, "content": null } },
    { "name": "linksTo",
      "letter": "L", "display_position": 1,
      "roles": [ "mentioner", "mentioned" ],
      "recorded_by": "mentioner",
      "folders": { "mentioner": null, "mentioned": null } },
    { "name": "subscribesTo",
      "letter": "S", "display_position": 2,
      "roles": [ "subscriber", "subscribee" ],
      "recorded_by": "subscriber",
      "folders": { "subscriber": "subscriberFolder",
                   "subscribee": "subscribeeFolder" } },
    { "name": "hidesFromSubs",
      "letter": "H", "display_position": 4,
      "roles": [ "hider", "hidden" ],
      "recorded_by": "hider",
      "folders": { "hider": "hiderFolder", "hidden": "hiddenFolder" } },
    { "name": "overrides",
      "letter": "O", "display_position": 3,
      "roles": [ "overrider", "overridden" ],
      "recorded_by": "overrider",
      "folders": { "overrider": "overriderFolder",
                   "overridden": "overriddenFolder" } }
  ]
}
